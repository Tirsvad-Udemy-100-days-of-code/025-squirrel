# Doxygen configuration for the squirrel census project.
# Build the source documentation with: doxygen Doxyfile
# Output goes to docs/doxygen/ (ignored by git). Everything not listed here
# keeps the Doxygen default.

PROJECT_NAME           = "Squirrel Census"
PROJECT_BRIEF          = "Count squirrels by primary fur colour"
PROJECT_NUMBER         = 0.1.0
OUTPUT_DIRECTORY       = docs/doxygen
INPUT                  = src docs/mainpage.dox
FILE_PATTERNS          = *.py *.dox
RECURSIVE              = YES
OPTIMIZE_OUTPUT_JAVA   = YES
EXTRACT_ALL            = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = NO
